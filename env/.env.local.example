# ==========================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ==========================================

# 1. LOCAL DATABASE (PostgreSQL / local Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tg_miniapp?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tg_miniapp?schema=public"

# 2. LOCAL SUPABASE CREDENTIALS
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_local_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_local_supabase_service_role_key"

# 3. TELEGRAM BOT (Development bot)
TELEGRAM_BOT_TOKEN="your_local_telegram_bot_token"
TELEGRAM_BOT_USERNAME="SmartBizDevBot"
TELEGRAM_SUPER_ADMIN_IDS="8229830002"
TELEGRAM_WEBHOOK_URL="http://localhost:3000/api/telegram/webhook"

# 4. LOCAL APP URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEBAPP_URL="http://localhost:3000"

# 5. SECURITY
JWT_SECRET="local_dev_only_jwt_secret_key_make_it_32_characters"
ENCRYPTION_SECRET="local_dev_only_encryption_secret_key"

# 6. AI SETTINGS
# Defaults to mock for offline / zero-cost local testing
AI_PROVIDER="mock"

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# 7. ENVIRONMENT SETTINGS
NEXT_PUBLIC_IS_DEVELOPMENT="true"
NODE_ENV="development"
