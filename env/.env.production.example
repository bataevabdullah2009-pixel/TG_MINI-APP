# ==========================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# 1. PRODUCTION DATABASE (Supabase Transaction Pool + Direct Connection)
# DATABASE_URL: Transaction Pool Connection (Port 6543, pgbouncer=true, connection_limit=1)
DATABASE_URL="postgresql://postgres.yourproject:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: Direct, non-pooling connection string (Port 5432)
DIRECT_URL="postgresql://postgres.yourproject:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# 2. SUPABASE PRODUCTION CREDENTIALS
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-app.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_production_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_production_supabase_service_role_key"

# 3. TELEGRAM BOT (Live bot instance)
TELEGRAM_BOT_TOKEN="your_live_production_telegram_bot_token"
TELEGRAM_BOT_USERNAME="SmartBizAI"
TELEGRAM_SUPER_ADMIN_IDS="8229830002"
TELEGRAM_WEBHOOK_URL="https://your-vercel-domain.vercel.app/api/telegram/webhook"

# 4. PRODUCTION APP URLs
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"
NEXT_PUBLIC_WEBAPP_URL="https://your-vercel-domain.vercel.app"

# 5. SECURITY (Generate strong keys e.g. using openssl rand -base64 32)
JWT_SECRET="generate_a_long_secure_random_hash_for_production"
ENCRYPTION_SECRET="generate_another_long_secure_random_hash_for_production"

# 6. PRODUCTION AI CONFIGURATION
# Default to "openrouter" or "polza"
AI_PROVIDER="openrouter"

OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# 7. PRODUCTION SETTINGS
NEXT_PUBLIC_IS_DEVELOPMENT="false"
NODE_ENV="production"
