# ==========================================
# MASTER ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. DATABASE (Prisma / Supabase / Neon / Railway)
# DATABASE_URL: pooled connection string (usually port 5432 or 6543 with pgbouncer=true)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1"
# DIRECT_URL: direct, non-pooling connection string (required for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# 2. SUPABASE INTEGRATION
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
# Optional server-side aliases supported by storage/order validation.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# 3. TELEGRAM MINI APP BOT
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="VitrinaAI_bot"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="VitrinaAI_bot"
NEXT_PUBLIC_TELEGRAM_MINI_APP_SHORT_NAME=""
TELEGRAM_SUPER_ADMIN_IDS="123456789"
TELEGRAM_WEBHOOK_URL="https://your-vercel-domain.vercel.app/api/telegram/webhook"
TELEGRAM_WEBHOOK_SECRET="generate_a_random_webhook_secret"

# 4. APP URLs
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"
NEXT_PUBLIC_WEBAPP_URL="https://your-vercel-domain.vercel.app/app"
NEXT_PUBLIC_AI_CARD_BOT_URL=""

# 5. SECURITY
JWT_SECRET="change_me_long_random_string"
ENCRYPTION_SECRET="change_me_long_random_string"
CRON_SECRET="change_me_long_random_string_for_cron"
# Production always validates Telegram initData. This also enforces validation outside production.
VALIDATE_TELEGRAM_DATA="true"

# 6. AI SETTINGS
# Production Vitrina AI uses Polza. Use mock only for explicit local tests.
AI_PROVIDER="polza"

# OpenRouter Configuration
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# Polza AI Configuration (required in production when AI_PROVIDER=polza)
POLZA_AI_API_KEY=""
POLZA_BASE_URL="https://polza.ai/api/v1"
POLZA_CHAT_BASE_URL="https://polza.ai/api/v1/chat/completions"
POLZA_MEDIA_BASE_URL="https://polza.ai/api/v1/media"
POLZA_TEXT_MODEL="z-ai/glm-4.7-flash"
POLZA_VISION_MODEL="google/gemini-3.1-flash-image-preview"
POLZA_IMAGE_MODEL="google/gemini-3.1-flash-image-preview"

# AI Fine-tuning & Limits
NEXT_PUBLIC_ENABLE_ADVANCED_AI="false"
AI_MAX_OUTPUT_TOKENS="1200"
AI_TEMPERATURE="0.3"
AI_MAX_PROMPT_CHARS="4000"
AI_CACHE_ENABLED="true"

# Phone verification demo mode
SMS_PROVIDER="mock"
PHONE_TEST_CODE_ENABLED="false"

# 7. CLOUD STORAGE (Optional, for file uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token"

SUPABASE_STORAGE_BUSINESS_MEDIA_BUCKET="business-media"
SUPABASE_STORAGE_PRODUCT_IMAGES_BUCKET="product-images"
SUPABASE_STORAGE_BUSINESS_COVERS_BUCKET="business-covers"
SUPABASE_STORAGE_PAYMENT_PROOFS_BUCKET="payment-proofs"

# Admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="secure_password_here"

# Redis (optional, for queue)
REDIS_URL="redis://localhost:6379"

# Telegram Admin Chat ID (will be set after bot is created)
TELEGRAM_ADMIN_CHAT_ID=""

# 8. ENVIRONMENT
NEXT_PUBLIC_IS_DEVELOPMENT="false"
NODE_ENV="production"
