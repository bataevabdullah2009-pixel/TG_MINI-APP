# ==========================================
# MASTER ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. DATABASE (Prisma / Supabase / Neon / Railway)
# DATABASE_URL: pooled connection string (usually port 5432 or 6543 with pgbouncer=true)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1"
# DIRECT_URL: direct, non-pooling connection string (required for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# 2. SUPABASE INTEGRATION
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# 3. TELEGRAM MINI APP BOT
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="SmartBizAI"
TELEGRAM_SUPER_ADMIN_IDS="8229830002"
TELEGRAM_WEBHOOK_URL="https://your-vercel-domain.vercel.app/api/telegram/webhook"

# 4. APP URLs
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"
NEXT_PUBLIC_WEBAPP_URL="https://your-vercel-domain.vercel.app"

# 5. SECURITY
JWT_SECRET="change_me_long_random_string"
ENCRYPTION_SECRET="change_me_long_random_string"

# 6. AI SETTINGS
# Supported providers: "mock", "openrouter", "polza"
AI_PROVIDER="mock"

# OpenRouter Configuration
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# Polza AI Configuration (Optional)
POLZA_AI_API_KEY=""
POLZA_BASE_URL="https://polza.ai/api/v1"
POLZA_TEXT_MODEL="z-ai/glm-4.7-flash"
POLZA_IMAGE_MODEL="google/gemini-3.1-flash-image-preview"

# AI Fine-tuning & Limits
AI_MAX_OUTPUT_TOKENS="500"
AI_TEMPERATURE="0.7"
AI_MAX_PROMPT_CHARS="4000"
AI_CACHE_ENABLED="true"

# 7. CLOUD STORAGE (Optional, for file uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token"

# 8. ENVIRONMENT
NEXT_PUBLIC_IS_DEVELOPMENT="false"
NODE_ENV="production"
