# Database
DATABASE_URL="postgresql://user:password@localhost:5432/telegram_miniapp_db"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_WEBHOOK_URL="https://yourdomain.com/api/telegram/webhook"

# AI Configuration
AI_PROVIDER="openrouter"
AI_MAX_OUTPUT_TOKENS="500"
AI_TEMPERATURE="0.7"
AI_MAX_PROMPT_CHARS="4000"
AI_CACHE_ENABLED="true"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="z-ai/glm-4.6"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_SITE_NAME="LocalAI Systems"

# Polza AI
POLZA_AI_API_KEY=""
POLZA_BASE_URL="https://polza.ai/api/v1"
POLZA_TEXT_MODEL="z-ai/glm-4.7-flash"
POLZA_IMAGE_MODEL="google/gemini-3.1-flash-image-preview"

# Limits
AI_FREE_PLAN_DAILY_LIMIT="10"
AI_PRO_PLAN_DAILY_LIMIT="100"
AI_BUSINESS_PLAN_DAILY_LIMIT="300"

# Telegram Mini App
NEXT_PUBLIC_TELEGRAM_APP_ID="your_app_id_here"

# JWT & Security
JWT_SECRET="your_super_secret_jwt_key_here_min_32_chars"
ENCRYPTION_SECRET="your_encryption_secret_here"

# Admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="secure_password_here"

# Redis (optional, for queue)
REDIS_URL="redis://localhost:6379"

# Telegram Admin Chat ID (will be set after bot is created)
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_SUPER_ADMIN_IDS="8229830002"

# Environment
NEXT_PUBLIC_IS_DEVELOPMENT="true"

# ==========================================
# STAGING & PRODUCTION DEPLOYMENT CHECKLIST
# ==========================================
# 
# 1. DATABASE datasource url (Neon / Supabase / Railway Postgres):
#    DATABASE_URL="postgresql://neondb_owner:***@ep-***.aws.neon.tech/tg_miniapp?sslmode=require"
# 
# 2. Vercel Blob Storage Token (Required for production uploads):
#    BLOB_READ_WRITE_TOKEN="vercel_blob_rw_***"
# 
# 3. JWT & Session encryption secrets (Ensure long, unique strings):
#    JWT_SECRET="use_a_secure_long_32_characters_key"
#    ENCRYPTION_SECRET="use_another_long_secure_string_here"
# 
# 4. Telegram Webhook:
#    TELEGRAM_WEBHOOK_URL="https://your-vercel-domain.vercel.app/api/telegram/webhook"
# 
# 5. Node Env:
#    NODE_ENV="production"
#    NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"

